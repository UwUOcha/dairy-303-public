# Admin is served by webd at /admin/. All checks apply to HTML and API alike.
# Also set admin_tg and/or admin_vk in the shared RASP_PROFILE used by raspd/webd.
ADMIN_ENABLED=false
# Your actual client addresses (not the reverse proxy).
ADMIN_ALLOW_IPS=
# Exact addresses/subnets of proxies allowed to overwrite X-Forwarded-For.
# Empty = use the TCP peer address; forwarded headers are ignored.
WEB_TRUSTED_PROXIES=
ADMIN_SAMPLE_INTERVAL=5m
ADMIN_RETENTION=720h
# Paths are configured by Compose; for a local binary:
# ADMIN_DB=run/admin.db
# ADMIN_PROC=/proc
# ADMIN_DISK=/
