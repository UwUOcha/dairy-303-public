# Конфигурация botd. Лежит рядом с compose.yaml: deploy/bot.env, chmod 600
# (на сервере это /opt/rasp/deploy/bot.env). Без докера — /etc/rasp/bot.env,
# chmod 640, владелец rasp.
#
# Файл отдельный не для порядка: контейнер с демоном расписания его не видит,
# как и контейнер ботов не видит токена вуза.
#
# Платформы независимы: botd поднимает те адаптеры, для которых есть токен.
# Хотя бы один нужен, иначе демон откажется стартовать.

# Токен бота от @BotFather.
TELEGRAM_TOKEN=

# Ключ доступа сообщества ВКонтакте.
#
# Берётся в настройках сообщества: Управление → Работа с API → Создать ключ.
# Права нужны два: «Сообщения сообщества» — чтобы читать и писать, и
# «Управление сообществом» — без него botd не сможет включить типы событий
# Long Poll и не получит ни одного нажатия кнопки.
#
# Там же, в Сообщения → Настройки для бота, надо включить «Возможности ботов».
VK_TOKEN=

# Отвечать во ВКонтакте только подписчикам сообщества.
#
# По умолчанию включено: неподписанный человек получает просьбу подписаться и
# кнопку «Я подписался», а сценарии бота открываются после проверки.
#
# Список подписчиков botd держит в памяти и обновляет полным обходом раз в
# сутки, а между обходами правит событиями вступления и выхода. Включать эти события
# руками не нужно — botd включает их сам, для этого ему и нужно право
# «Управление сообществом».
#
# Выключается на время отладки: VK_REQUIRE_SUBSCRIPTION=false
VK_REQUIRE_SUBSCRIPTION=true

# ── связь с автором ─────────────────────────────────────────────────────────
#
# Кому уходят обращения из кнопки «💬 Написать автору» в разделе «☰ Ещё».
# Пусто на обеих площадках — кнопки в боте нет вовсе: писать в пустоту хуже,
# чем не предлагать.
#
# Автор один, а площадок две, поэтому адресат выбирается один на всю
# установку: обращение из ВКонтакте приезжает в телеграм, если телеграм задан.
# Ответ уходит обратно на площадку человека — её помнит очередь исходящих.
#
# ADMIN_TG_ID — численный id аккаунта в телеграме (его показывает, например,
# @userinfobot). Не @username: боту адресоваться по имени нельзя.
#
# ADMIN_VK_ID — численный id страницы ВКонтакте. Пока телеграм задан, адресатом
# работает он, и это поле лежит запасным: уберёшь TELEGRAM_TOKEN или он
# протухнет — связь с автором сама переедет во ВКонтакте, без правок кода.
# Заодно это опора для будущих админских возможностей внутри бота: узнать
# автора на своей площадке можно только по такому id.
#
# Отвечать можно прямо из переписки: под каждым обращением есть кнопка
# «✍️ Ответить». Пауза между обращениями одного человека — 5 минут.
ADMIN_TG_ID=
ADMIN_VK_ID=

# Куда зовёт кнопка «🔗 Поделиться ботом» с каждой площадки.
#
# Значения по умолчанию зашиты в код и совпадают с этими — переопределять
# нужно только на своей копии бота.
# BOT_LINK_TG=https://t.me/your_bot
# BOT_LINK_VK=https://vk.me/your_bot
