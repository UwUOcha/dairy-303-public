# Compatibility example for core settings. See deploy/core.env.example.
# University API credentials belong only to the adapter.
RASP_PROFILE=/etc/rasp/profile.json
PROVIDER_URL=http://127.0.0.1:8310
PROVIDER_TOKEN=
RASP_IMPORT_LEGACY_IDS=false
RASP_DB=/var/lib/rasp/schedule.db
RASP_SOCKET=/run/rasp/api.sock
