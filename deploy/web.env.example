# Закрытая бета за Caddy. Токены площадок и SQLite сайту не нужны.
WEB_LISTEN=127.0.0.1:8306
RASP_SOCKET=/run/rasp/api.sock
# Точный HTTPS origin без пути: проверяется для POST авторизации.
# Настройте HTTPS origin своей установки; пустое значение берётся из профиля.
WEB_PUBLIC_URL=https://schedule.example.org
